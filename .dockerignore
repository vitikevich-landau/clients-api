# Что НЕ отправлять в контекст сборки Docker.
#
# Всё, что здесь перечислено, не попадёт в образ даже случайно
# и не будет каждый раз пересылаться демону Docker — сборка быстрее.

# Git — самый большой источник бесполезного веса.
.git
.gitignore

# Секреты. КРИТИЧНО: .env не должен попасть в образ никогда.
# Образ уезжает в реестр, откуда его может достать кто угодно с доступом.
.env
.env.local

# Собранные локально бинарники — в образе собираются заново.
bin/
*.test

# Отчёты и профили
coverage.out
coverage.html
*.prof

# Каталоги IDE
.idea/
.vscode/

# Файлы, не влияющие на сборку
README.md
Makefile
docker-compose.yml
Dockerfile
.golangci.yml
