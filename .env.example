# Пример конфигурации.
#
# Использование:
#   cp .env.example .env
#
# Файл .env добавлен в .gitignore и в репозиторий не попадает.
# Настоящие секреты хранятся в Vault / AWS Secrets Manager / k8s Secret,
# а не в файлах рядом с кодом.
#
# Приложение читает переменные ОКРУЖЕНИЯ. Файл .env — лишь удобство
# для локальной разработки: godotenv подгружает его при старте, но
# НЕ перезаписывает уже установленные переменные. Настоящее окружение
# всегда важнее файла.

# ---------------------------------------------------------------------------
# Приложение
# ---------------------------------------------------------------------------

# Окружение: local | dev | prod
# В prod включаются дополнительные проверки конфига:
# запрещены CORS "*" и DB_SSLMODE=disable.
APP_ENV=local

# ---------------------------------------------------------------------------
# HTTP-сервер
# ---------------------------------------------------------------------------

HTTP_PORT=8080

# Сколько ждём получения запроса целиком (защита от медленных клиентов).
HTTP_READ_TIMEOUT=10s

# Сколько отводим на запись ответа.
HTTP_WRITE_TIMEOUT=15s

# Сколько держим keep-alive соединение без запросов.
HTTP_IDLE_TIMEOUT=60s

# Потолок на обработку одного запроса нашей логикой.
# ОБЯЗАН быть меньше HTTP_WRITE_TIMEOUT — иначе сервер оборвёт соединение
# раньше, чем мы успеем отдать аккуратный ответ 504.
HTTP_REQUEST_TIMEOUT=10s

# Сколько даём текущим запросам доработать при остановке сервиса.
HTTP_SHUTDOWN_TIMEOUT=15s

# Домены фронтенда через запятую. Пусто = CORS выключен.
# Значение "*" разрешено только вне prod.
HTTP_CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_USER=clients
DB_PASSWORD=clients_dev_password
DB_NAME=clients

# disable — только для локальной разработки.
# В проде: require, verify-ca или verify-full.
DB_SSLMODE=disable

# Размер пула соединений.
# ВАЖНО: реплики_сервиса * DB_MAX_CONNS должно быть меньше,
# чем max_connections у Postgres (по умолчанию ~100).
DB_MAX_CONNS=10
DB_MIN_CONNS=2

DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------

# Ключ подписи токенов. Минимум 32 символа — проверяется при старте.
#
# Утечка секрета означает, что кто угодно может выписать себе
# админский токен. Генерировать так:
#   openssl rand -base64 48
JWT_SECRET=local-development-secret-key-change-me-in-production

# Срок жизни токена.
JWT_TTL=24h

# Кто выдал токен (claim "iss"). Проверяется при разборе.
JWT_ISSUER=clients-api

# ---------------------------------------------------------------------------
# Логирование
# ---------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=debug

# json — для прода (разбирается системами сбора логов)
# text — для локальной разработки (цветной, читается глазами)
LOG_FORMAT=text

# Добавлять в лог файл и строку вызова. Удобно при отладке,
# немного замедляет логирование.
LOG_ADD_SOURCE=true
