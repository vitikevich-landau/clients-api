# Многоступенчатая сборка (multi-stage build).
#
# Смысл: собирать Go-приложение нужно в образе с компилятором (~800 МБ),
# а ЗАПУСКАТЬ его можно в крошечном образе — Go компилируется в один
# самодостаточный бинарник. Итоговый образ получается ~20 МБ вместо ~800.
#
# Меньше образ = быстрее выкатка, меньше места в реестре и, главное,
# меньше поверхность атаки: в финальном образе нет ни компилятора,
# ни исходников, ни пакетного менеджера.

# ============================================================================
#  Ступень 1: сборка
# ============================================================================
# Тег 1.25 указывает на последний патч ветки 1.25 — важно, потому что
# зависимость goose требует минимум Go 1.25.7.
FROM golang:1.25-alpine AS builder

WORKDIR /build

# Сначала копируем ТОЛЬКО файлы модулей и качаем зависимости.
#
# Это ключевой приём кэширования слоёв Docker: слой пересобирается,
# только если изменились скопированные в него файлы. Правишь код —
# go.mod не менялся — зависимости берутся из кэша, сборка занимает секунды.
# Если копировать всё сразу, любая правка кода перекачивала бы весь модуль.
COPY go.mod go.sum ./
RUN go mod download

# Теперь исходники.
COPY . .

# Собираем.
#
# CGO_ENABLED=0 — статическая сборка без зависимостей от системных
# библиотек. Без этого бинарник потребует glibc и не запустится в alpine,
# где вместо неё musl. Классическая ошибка «работает у меня, падает в докере».
#
# -trimpath убирает из бинарника абсолютные пути сборочной машины:
# и размер меньше, и не утекает структура каталогов разработчика.
#
# -ldflags:
#   -s -w        — выбросить таблицу символов и отладочную информацию (~30% размера)
#   -X main.version — подставить версию в переменную из main.go
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /build/api \
    ./cmd/api

# ============================================================================
#  Ступень 2: запуск
# ============================================================================
FROM alpine:3.21

# ca-certificates нужны, если сервис пойдёт по HTTPS наружу
# (вебхуки, платёжки, внешние API). Без них любой TLS-запрос
# упадёт с «certificate signed by unknown authority».
#
# tzdata — чтобы работали именованные таймзоны. В голом alpine
# time.LoadLocation("Europe/Moscow") вернёт ошибку.
RUN apk add --no-cache ca-certificates tzdata

# ЗАПУСК ОТ НЕПРИВИЛЕГИРОВАННОГО ПОЛЬЗОВАТЕЛЯ.
#
# По умолчанию контейнер работает от root. Если в приложении найдут
# уязвимость, атакующий получит root ВНУТРИ контейнера — а оттуда
# выбраться наружу заметно проще, чем от обычного пользователя.
# Это одна из самых дешёвых мер безопасности: две строки.
RUN addgroup -g 1000 -S app && adduser -u 1000 -S app -G app

WORKDIR /app

# Копируем только бинарник. Исходники, компилятор и кэш модулей
# остались в первой ступени и в финальный образ не попадут.
#
# Миграции копировать НЕ НУЖНО: они вшиты в бинарник через //go:embed.
COPY --from=builder /build/api /app/api

USER app

EXPOSE 8080

# Проверка состояния контейнера силами самого Docker.
# Использует нашу пробу готовности: если база отвалилась,
# контейнер помечается unhealthy.
#
# wget есть в alpine из коробки, ставить ничего не надо.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/healthz || exit 1

# Форма exec (массив), а НЕ shell-форма ("./api").
#
# В shell-форме процессом с PID 1 становится /bin/sh, и он НЕ передаёт
# сигналы дочернему процессу. Итог: docker stop не доходит до приложения,
# graceful shutdown не срабатывает, и через 10 секунд контейнер убивают
# принудительно вместе со всеми незавершёнными запросами.
ENTRYPOINT ["/app/api"]
